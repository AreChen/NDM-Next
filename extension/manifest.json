{
  "manifest_version": 3,
  "name": "NDM Next",
  "version": "1.1.1",
  "description": "A thoughtful browser companion for NDM Next and Neat Download Manager.",
  "permissions": [
    "downloads",
    "storage",
    "tabs",
    "webRequest",
    "cookies",
    "nativeMessaging",
    "notifications",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["rules.js", "media-ui.js", "content.js"],
    "run_at": "document_idle",
    "all_frames": true
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "NDM Next",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
